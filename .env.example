# Шаблон настроек бота. Скопируйте файл в .env и впишите свои значения:
#   cp .env.example .env
# Файл .env в git не попадает (см. .gitignore) — токен останется у вас.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# --- Необязательные настройки ---
# Путь к файлу базы SQLite
# DB_PATH=read_it_later.db
# Сколько секунд ждать сайт при загрузке заголовка
# FETCH_TIMEOUT=10
# Порт HTTP-заглушки «Bot is live!» (хостинг вроде Render задаёт его сам)
# PORT=10000
